# ============================================================
# VoiceOps AI — environment configuration
# Copy to `.env` and adjust. `.env` is gitignored.
# ============================================================

# ---------- Core ----------
ENV=local
LOG_LEVEL=info

# ---------- PostgreSQL ----------
POSTGRES_USER=voiceops
POSTGRES_PASSWORD=voiceops
POSTGRES_DB=voiceops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Inside containers the host is `postgres`, not `localhost`.
DATABASE_URL=postgresql://voiceops:voiceops@localhost:5432/voiceops

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- Service ports ----------
AI_PORT=8000
FLIGHT_MOCK_PORT=8002
API_PORT=3000
WEB_PORT=3001

# ============================================================
# AI providers
# Each layer is swappable: `local` runs on your Mac (free, offline),
# hosted options use free tiers. See docs/decisions/.
# ============================================================

# ---------- Speech-to-text: local | groq ----------
STT_PROVIDER=local
WHISPER_BIN=whisper-cli
# small.en over base.en deliberately: base hallucinates flight numbers
# ("AI858" -> "AIA-858"), and the extra accuracy costs only ~240ms.
WHISPER_MODEL=./models/whisper/ggml-small.en.bin

# ---------- LLM: ollama | groq | gemini ----------
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b-instruct
# Containers reach the host-native Ollama here (no Metal inside Docker on macOS).
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Text-to-speech: piper | gemini ----------
TTS_PROVIDER=piper
PIPER_BIN=piper
PIPER_VOICE=./models/piper/en_US-lessac-medium.onnx

# ---------- Hosted free-tier keys (optional; leave blank to stay fully local) ----------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# Downstream flight service
# ============================================================
FLIGHT_API_BASE_URL=http://localhost:8002

# ---------- Chaos engine (Phase 2) ----------
# Deliberately break the flight service to exercise retries/backoff.
CHAOS_ENABLED=false
CHAOS_ERROR_RATE=0.0
CHAOS_LATENCY_MS=0
CHAOS_ERROR_KIND=503

# ============================================================
# Queue + retry policy (Phase 6)
# ============================================================
QUEUE_NAMESPACE=voiceops
WORKER_CONCURRENCY=4
VISIBILITY_TIMEOUT_SEC=60
MAX_ATTEMPTS=5
BACKOFF_BASE_SEC=2
BACKOFF_MAX_SEC=300

# ============================================================
# Auth (Phase 7)
# ============================================================
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=8h
